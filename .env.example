# =============================================================================
# AuditMind — Environment Variables Template
# Copy this file to .env and fill in your values
# Set these in Vercel Dashboard > Project > Settings > Environment Variables
# =============================================================================

# --- Supabase (Required) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Backend API (Required) ---
# For production: deploy apps/api to Railway, Render, or Fly.io, then set this URL
VITE_API_URL=https://your-api-server.railway.app

# --- WebSocket (Required for realtime chat) ---
# Must match your API server's WebSocket endpoint
VITE_WS_URL=wss://your-api-server.railway.app/ws

# --- Server only (apps/api/.env). Never prefix these with VITE_. ---
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=your-server-only-provider-key
ML_SERVICE_URL=http://localhost:8000
# Optional queue. Without it, the in-memory queue is NOT restart-durable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
