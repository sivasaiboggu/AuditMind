{
  "name": "auditmind",
  "version": "1.0.0",
  "description": "Enterprise-Grade Contract Risk & Compliance Analyzer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:ml": "node scripts/python.mjs dev",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "install:all": "npm install && npm run setup:ml",
    "start:api": "npm run start --workspace=apps/api",
    "setup:ml": "node scripts/python.mjs setup",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:security": "npm run build:api && node --test apps/api/tests/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
